<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable><LangVersion>latest</LangVersion><AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages><AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects><GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>CMUmcl.Updater</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../CMUmcl/Update/UpdateProtocol.cs" Link="UpdateProtocol.cs" />
    <Compile Include="../CMUmcl/Update/UpdateTransaction.cs" Link="UpdateTransaction.cs" />
  </ItemGroup>
</Project>
