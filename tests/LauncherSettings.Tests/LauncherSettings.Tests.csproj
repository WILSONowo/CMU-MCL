<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net48</TargetFramework>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages><AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects><GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType><UseWPF>true</UseWPF><AssemblyName>CMUmcl.LauncherSettings.Tests</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <ApplicationManifest>../../CMUmcl/app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../../CMUmcl/CMUmcl.csproj" /></ItemGroup>
  <ItemGroup><Resource Include="../../CMUmcl/Assets/*.ico" Link="Assets/%(Filename)%(Extension)" /><Resource Include="../../CMUmcl/Assets/*.png" Link="Assets/%(Filename)%(Extension)" /><Resource Include="../../CMUmcl/Assets/InstanceIcons/*" Link="Assets/InstanceIcons/%(Filename)%(Extension)" /></ItemGroup>
</Project>
